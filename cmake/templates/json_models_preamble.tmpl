
namespace revet::json {

namespace detail {
inline std::string quote(std::string_view s) {
    std::string out; out.reserve(s.size() + 2); out += '"';
    for (char c : s) {
        switch (c) {
            case '"': out += "\\\""; break;
            case '\\': out += "\\\\"; break;
            case '\n': out += "\\n"; break;
            case '\r': out += "\\r"; break;
            case '\t': out += "\\t"; break;
            default:
                if (static_cast<unsigned char>(c) < 0x20) {
                    char buf[8]; std::snprintf(buf, sizeof(buf), "\\u%04x", c); out += buf;
                } else out += c;
        }
    }
    out += '"'; return out;
}
} // namespace detail

