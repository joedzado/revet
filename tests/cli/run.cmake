# revet CLI end to end, without network or a build:
#   cmake -DREVET=<revet binary> -DFRAMEWORK=<repo root> -DWORK=<scratch dir> -P run.cmake
cmake_minimum_required(VERSION 3.20)
set(failures "")
macro(expect_rc want)
    if(NOT rc EQUAL ${want})
        string(APPEND failures "${step}: exit ${rc}, wanted ${want}\n  stdout: ${out}\n  stderr: ${err}\n")
    endif()
endmacro()
macro(expect_contains haystack needle)
    string(FIND "${haystack}" "${needle}" _at)
    if(_at EQUAL -1)
        string(APPEND failures "${step}: missing '${needle}' in:\n${haystack}\n")
    endif()
endmacro()
macro(revet)
    execute_process(COMMAND ${CMAKE_COMMAND} -E env
            GIT_AUTHOR_NAME=revet GIT_AUTHOR_EMAIL=revet@localhost GIT_COMMITTER_NAME=revet GIT_COMMITTER_EMAIL=revet@localhost
            ${REVET} ${ARGN}
        WORKING_DIRECTORY ${cwd} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
endmacro()

file(REMOVE_RECURSE ${WORK})
file(MAKE_DIRECTORY ${WORK})
set(cwd ${WORK})

set(step "--version")
revet(--version)
expect_rc(0)
file(READ ${FRAMEWORK}/VERSION version)
string(STRIP "${version}" version)
expect_contains("${out}" "${version}")

set(step "--help")
revet(--help)
expect_rc(0)
expect_contains("${out}" "Commands:")

set(step "unknown command")
revet(frobnicate)
expect_rc(1)
expect_contains("${err}" "unknown command: frobnicate")

set(step "not a project")
revet(build)
expect_rc(1)
expect_contains("${err}" "no revet.toml found")

set(step "new --empty")
revet(new demo --empty)
expect_rc(0)
foreach(f revet.toml app/routes/index.cpp app/routes/site_init.cpp .revet_version .gitignore .git)
    if(NOT EXISTS ${WORK}/demo/${f})
        string(APPEND failures "${step}: demo/${f} missing\n")
    endif()
endforeach()
if(EXISTS ${WORK}/demo/CMakeLists.txt)
    string(APPEND failures "${step}: CMakeLists.txt should be generated at build time, not copied\n")
endif()

set(step "new (exists)")
revet(new demo)
expect_rc(1)
expect_contains("${err}" "already exists")

set(cwd ${WORK}/demo)
set(step "add fmt@10.2.1")
revet(add fmt@10.2.1)
expect_rc(0)
file(READ ${WORK}/demo/revet.toml toml)
expect_contains("${toml}" "[build.dependencies]")
expect_contains("${toml}" "fmt = \"fmt/10.2.1\"")

set(step "add (unchanged)")
revet(add fmt/10.2.1)
expect_rc(0)
expect_contains("${out}" "already in dependencies")

set(step "remove fmt")
revet(remove fmt)
expect_rc(0)
file(READ ${WORK}/demo/revet.toml toml)
string(FIND "${toml}" "fmt = " at)
if(NOT at EQUAL -1)
    string(APPEND failures "${step}: fmt still in revet.toml\n")
endif()

set(step "remove (missing)")
revet(remove fmt)
expect_rc(1)
expect_contains("${err}" "not found in [build.dependencies]")

set(step "upgrade")
revet(upgrade)
expect_rc(0)
expect_contains("${out}" "using framework ${version}")

set(step "bad --port")
revet(dev --port nope)
expect_rc(1)
expect_contains("${err}" "invalid int value")

set(step "bad port in revet.toml")
file(READ ${cwd}/revet.toml toml_before)
string(REPLACE "port = 8080" "port = 70000" toml_bad_port "${toml_before}")
file(WRITE ${cwd}/revet.toml "${toml_bad_port}")
revet(dev)
expect_rc(1)
expect_contains("${err}" "invalid port in revet.toml: 70000")
file(WRITE ${cwd}/revet.toml "${toml_before}")

set(step "format reports a clang-format failure")
find_program(CLANG_FORMAT clang-format)
if(CLANG_FORMAT)
    file(WRITE ${cwd}/.clang-format "NotAnOption: true\n")
    revet(format)
    expect_rc(1)
    expect_contains("${err}" "clang-format failed")
    file(REMOVE ${cwd}/.clang-format)
endif()

if(failures)
    message(FATAL_ERROR "cli test failed:\n${failures}")
endif()
message(STATUS "cli: all steps passed")
