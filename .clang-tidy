---
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  cert-*,
  cppcoreguidelines-*,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-type-member-init,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -cppcoreguidelines-init-variables,
  -cppcoreguidelines-avoid-magic-numbers,
  google-*,
  -google-explicit-constructor,
  -google-readability-braces-around-statements,
  -google-runtime-int,
  hicpp-*,
  -hicpp-explicit-conversions,
  -hicpp-member-init,
  -hicpp-braces-around-statements,
  -hicpp-no-array-decay,
  performance-*,
  readability-*,
  -readability-identifier-length,
  -readability-trailing-comma,
  -readability-braces-around-statements,
  -readability-magic-numbers,
  -readability-function-cognitive-complexity,
  -readability-convert-member-functions-to-static,
  -misc-include-cleaner,
  -misc-use-internal-linkage,
  modernize-*,
  misc-const-correctness,
  misc-non-private-member-variables-in-classes

WarningsAsErrors: true
HeaderFilterRegex: '^(src/|include/)'

CheckOptions:
  # Map-like operator[] (insert or key lookup), not an index.
  cppcoreguidelines-pro-bounds-avoid-unchecked-container-access.ExcludeClasses: '::std::map;::std::unordered_map;::std::flat_map;::web::ParamMap;::simdjson::dom::object;::simdjson::dom::element'
  # Plain structs with all-public members are fine (C.2, C.131).
  misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic: true
  # Positive literals in bit operations (`x & 0x3F`, `n << 8`) can't carry a sign (ES.101).
  bugprone-signed-bitwise.IgnorePositiveIntegerLiterals: true
  hicpp-signed-bitwise.IgnorePositiveIntegerLiterals: true
  modernize-loop-convert.MinConfidence: risky
  modernize-use-auto.MinTypeNameLength: 0
  modernize-use-designated-initializers.IgnoreSingleElementAggregates: false
  modernize-use-std-print.StrictMode: true
  modernize-use-std-format.StrictMode: true
